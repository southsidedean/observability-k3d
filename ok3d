#!/bin/sh
# ok3d: check this machine, create the cluster and deploy, or delete the cluster.
#
#   ./ok3d check      Is this machine ready, and are the settings valid? Changes nothing.
#   ./ok3d apply      Check, then make what's missing: the data root's folders, the
#                     certificate authority, and the cluster. Then deploy both releases
#                     (ok3d-platform, then ok3d). Safe to run again: it changes only what's
#                     different.
#   ./ok3d delete     Delete the cluster. The data root stays, so `./ok3d apply` brings
#                     everything back. Asks first; --yes skips the question.
#   ./ok3d demo up    Start the simulated network: a few small containers that stand in for a
#                     home network's devices, and a fake UniFi controller. docs/demo.md says
#                     more. Also: demo down, demo status, demo fail <device>, demo fix <device>.
#   ./ok3d test-alert Send a test alert through Alertmanager, to check that alerts reach you.
#   ./ok3d validate settings FILE [--from-dashboard]
#   ./ok3d validate devices FILE
#                     Check a settings or devices file that isn't in place yet, the way check
#                     does: settings with your devices, devices with your settings. Changes
#                     nothing. The helper runs this before it saves a file the Dashboard sent;
#                     --from-dashboard also refuses a change to the settings only you may
#                     change on the server (chart/ok3d-files/README.md).
#   ./ok3d version    Print ok3d's version.
#
# Settings come from settings.yaml next to this script (start from settings.example.yaml),
# or the file named in OK3D_SETTINGS. Helm checks them against the chart's schema before
# anything changes.
#
# The Dashboard (from 0.5) runs these same commands through the helper.
set -eu

root=$(cd "$(dirname "$0")" && pwd)
cd "$root"
settings=${OK3D_SETTINGS:-$root/settings.yaml}
# Your devices (devices.yaml, from devices.example.yaml or devices.demo.yaml), if you've made
# the file; ok3d works without one, watching nothing but itself.
devices=${OK3D_DEVICES:-$root/devices.yaml}
# Your secrets (.env, from .env.example), read only for the parts that need them.
envfile=${OK3D_ENV:-$root/.env}

# The minimum versions ok3d is tested with. k3d 5.9 runs Kubernetes 1.37, which kagent 1.0
# needs.
min_k3d=5.9.0
min_helm=3.0.0
# The inotify limits two k3d clusters on one machine need (the defaults run out).
min_instances=1024
min_watches=1048576
# Free memory below this gets a warning: the whole stack needs about 11 GiB, and about 7 with
# agents off (PLAN.md, "The host").
warn_memory_gib=7

# The simulated network (docs/demo.md): its devices are listed in demo/network.tsv, on a Docker
# network of their own in 198.51.100.0/24, a range reserved for documentation. The gateway
# Docker needs takes .254, leaving .1 for the simulated router. Docker gives addresses it
# picks itself (to the cluster's node, say) only from .192 to .223, so it never hands out a
# stopped device's fixed address. Every container runs this image, pinned by digest
# (Renovate proposes newer ones).
demo_image=python:3.12.13-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322
demo_network=ok3d-demo
demo_subnet=198.51.100.0/24
demo_gateway=198.51.100.254
demo_dynamic=198.51.100.192/27

# The comment at the top of this file, from its second line to its last, without the #s.
usage() {
	awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

failures=0
pass() { echo "PASS  $1"; }
warn() { echo "WARN  $1"; }
fail() {
	echo "FAIL  $1"
	failures=$((failures + 1))
}

# version_at_least HAVE NEED: whether dotted version HAVE is NEED or newer.
version_at_least() {
	[ "$(printf '%s\n%s\n' "$2" "$1" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)" = "$2" ]
}

# The charts' dependencies, fetched once into chart/*/charts/ at the versions in each
# Chart.lock. Helm fetches only from repositories it knows, so ok3d's are added first.
fetch_dependencies() {
	for chart in chart/ok3d-platform chart/ok3d; do
		helm dependency list "$chart" 2>/dev/null | grep -q -e missing -e "wrong version" || continue
		helm repo add jetstack https://charts.jetstack.io --force-update >/dev/null
		helm repo add prometheus-community https://prometheus-community.github.io/helm-charts --force-update >/dev/null
		echo "Fetching $chart's dependencies, at the versions in its Chart.lock."
		helm dependency build "$chart" >/dev/null
	done
}

# The values files for the ok3d chart, as Helm arguments: your settings, then your devices
# if you have a devices.yaml.
values_args() {
	printf '%s\n' --values "$settings"
	[ ! -f "$devices" ] || printf '%s\n' --values "$devices"
}

# check_sections KIND FILE: whether a settings or devices file holds only the sections it may
# (chart/ok3d-files/README.md): your own settings, never the chart's, which choose images and
# how pods run. Helm reads the file, so YAML's every way of writing a key is covered.
check_sections() {
	if ! helm template ok3d-files "chart/ok3d-files/$1" --values "$2" >/dev/null; then
		echo "$2 may hold only your own $1 (above): see chart/ok3d-files/README.md." >&2
		return 1
	fi
}

# protected_settings FILE: the settings in FILE that only you may change, one per line, as
# name=JSON (chart/ok3d-files/settings/templates/protected.yaml).
protected_settings() {
	helm template ok3d-files chart/ok3d-files/settings --values "$1" \
		--show-only templates/protected.yaml | sed -n 's/^# protected //p'
}

# Reads the settings ok3d needs as shell variables (CLUSTER_NAME, DATA_ROOT, and the rest),
# from the chart's cluster-settings.yaml, rendered by Helm after the schema has checked them.
load_settings() {
	if [ ! -f "$settings" ]; then
		echo "No settings file at $settings. Copy settings.example.yaml to settings.yaml and fill it in." >&2
		exit 1
	fi
	fetch_dependencies
	check_sections settings "$settings" || exit 1
	rendered=$(helm template ok3d chart/ok3d --values "$settings" \
		--show-only templates/cluster-settings.yaml) || {
		echo "The settings in $settings aren't valid (above)." >&2
		exit 1
	}
	# Lines look like:  CLUSTER_NAME: "ok3d". The schema limits values to safe characters, and
	# a value with a quote, backslash, dollar sign, or backtick is refused here as well.
	q="'"
	assignments=$(printf '%s\n' "$rendered" |
		sed -n "s/^  \([A-Z][A-Z0-9_]*\): \"\([^\"\\\\\$\`$q]*\)\"\$/\1=$q\2$q/p")
	eval "$assignments"
	: "${CLUSTER_NAME:?} ${K3S_IMAGE:?} ${NETWORK:?} ${API_PORT:?} ${PUBLISH_ADDRESS:?}"
	: "${HTTPS_PORT:?} ${DATA_ROOT:?} ${TLS_MODE:?} ${DOMAIN:?}"
	: "${METRICS_RETENTION:?} ${METRICS_RETENTION_SIZE:?} ${MODULE_UNIFI:?}"
	: "${ALERTS_NTFY:?} ${ALERTS_NTFY_SERVER:?} ${ALERTS_NTFY_TOKEN:?} ${ALERTS_EMAIL:?} ${ALERTS_DEADMAN:?}"
	context="k3d-$CLUSTER_NAME"
}

# env_value_if_any KEY: like env_value, but empty when there's no .env at all.
env_value_if_any() {
	[ -f "$envfile" ] || return 0
	env_value "$1"
}

# env_value KEY: the value of KEY in .env, read as plain text (never run as shell), with
# surrounding quotes removed. Refuses a .env that anyone else can read.
env_value() {
	if [ ! -f "$envfile" ]; then
		echo "No .env at $envfile. Copy .env.example to .env, fill it in, and chmod 600 .env." >&2
		exit 1
	fi
	# Any permission for the group or others (read, write, or run) is too much.
	if [ -n "$(find "$envfile" \( -perm -040 -o -perm -020 -o -perm -010 -o -perm -004 -o -perm -002 -o -perm -001 \) -print)" ]; then
		echo "$envfile can be read by others. Make it yours alone: chmod 600 $envfile" >&2
		exit 1
	fi
	sed -n "s/^$1=//p" "$envfile" | tail -n 1 | sed "s/^[\"']//; s/[\"']\$//"
}

check_tools() {
	for tool in docker k3d helm kubectl openssl; do
		if ! command -v "$tool" >/dev/null 2>&1; then
			fail "$tool isn't installed (docs/install.md says how to get it)"
		fi
	done
	if command -v docker >/dev/null 2>&1; then
		if docker info >/dev/null 2>&1; then
			pass "Docker is running"
		else
			fail "Docker isn't running, or you can't reach it (are you in the docker group?)"
		fi
	fi
	if command -v k3d >/dev/null 2>&1; then
		have=$(k3d version 2>/dev/null | sed -n 's/^k3d version v\{0,1\}\([0-9.]*\).*/\1/p' | head -n 1)
		if [ -n "$have" ] && version_at_least "$have" "$min_k3d"; then
			pass "k3d $have"
		else
			fail "k3d ${have:-of an unknown version}: ok3d needs $min_k3d or newer"
		fi
	fi
	if command -v helm >/dev/null 2>&1; then
		have=$(helm version --short 2>/dev/null | sed -n 's/^v\([0-9.]*\).*/\1/p')
		if [ -n "$have" ] && version_at_least "$have" "$min_helm"; then
			pass "Helm $have"
		else
			fail "Helm ${have:-of an unknown version}: ok3d needs $min_helm or newer"
		fi
	fi
}

check_linux_limits() {
	[ "$(uname -s)" = Linux ] || return 0
	instances=$(cat /proc/sys/fs/inotify/max_user_instances 2>/dev/null || echo 0)
	watches=$(cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null || echo 0)
	if [ "$instances" -ge "$min_instances" ] && [ "$watches" -ge "$min_watches" ]; then
		pass "inotify limits ($instances instances, $watches watches)"
	else
		fail "inotify limits are $instances instances and $watches watches; ok3d needs $min_instances and $min_watches. Add to /etc/sysctl.d/60-ok3d.conf, then run sudo sysctl --system:
      fs.inotify.max_user_instances = $min_instances
      fs.inotify.max_user_watches = $min_watches"
	fi
	available_kib=$(sed -n 's/^MemAvailable: *\([0-9]*\) kB$/\1/p' /proc/meminfo 2>/dev/null)
	if [ -n "$available_kib" ]; then
		available_gib=$((available_kib / 1024 / 1024))
		if [ "$available_gib" -ge "$warn_memory_gib" ]; then
			pass "$available_gib GiB of memory free"
		else
			warn "$available_gib GiB of memory free: the whole stack needs about 11 GiB (7 with agents off)"
		fi
	fi
}

check_data_root() {
	if [ ! -d "$DATA_ROOT" ]; then
		fail "the data root $DATA_ROOT doesn't exist. Make it, owned by you:
      sudo install -d -o $(id -un) -m 0755 $DATA_ROOT"
		return
	fi
	if [ ! -w "$DATA_ROOT" ]; then
		fail "you can't write to the data root $DATA_ROOT. Give it to yourself:
      sudo chown $(id -un) $DATA_ROOT"
		return
	fi
	if [ "$(uname -s)" = Linux ]; then
		fstype=$(stat -f -c %T "$DATA_ROOT" 2>/dev/null || echo unknown)
		if [ "$fstype" = overlayfs ] || [ "$fstype" = overlay ]; then
			fail "the data root $DATA_ROOT is on an overlay filesystem; it needs a real one (ext4, xfs, btrfs)"
			return
		fi
	fi
	pass "the data root $DATA_ROOT"
}

# Each alert destination that's on needs its secret in .env.
check_alert_secrets() {
	need_secret() {
		if [ -z "$(env_value "$2")" ]; then fail "$1 is on, but $2 in .env is empty"; fi
	}
	[ "$ALERTS_NTFY" != true ] || need_secret alerts.ntfy NTFY_TOPIC
	[ "$ALERTS_NTFY" != true ] || [ "$ALERTS_NTFY_TOKEN" != true ] || need_secret alerts.ntfy.useToken NTFY_TOKEN
	[ "$ALERTS_EMAIL" != true ] || need_secret alerts.email SMTP_PASSWORD
	[ "$ALERTS_DEADMAN" != true ] || need_secret alerts.deadman DEADMAN_URL
	if [ "$ALERTS_NTFY" != true ] && [ "$ALERTS_EMAIL" != true ]; then
		warn "no alert destination is on: alerts won't reach you (docs/alerts.md sets one up)"
	fi
}

cmd_check() {
	load_settings
	pass "the settings in $settings"
	if [ -f "$devices" ]; then
		# shellcheck disable=SC2046 # one argument per line, on purpose
		if check_sections devices "$devices" && helm template ok3d chart/ok3d $(values_args) >/dev/null; then
			pass "the devices in $devices"
		else
			fail "the devices in $devices (above)"
		fi
	else
		warn "no devices.yaml: ok3d will watch only itself (start from devices.example.yaml)"
	fi
	if [ "$MODULE_UNIFI" = true ] && [ -z "$(env_value UNIFI_API_KEY)" ]; then
		fail "modules.unifi is on, but UNIFI_API_KEY in .env is empty"
	fi
	check_alert_secrets
	check_tools
	check_linux_limits
	check_data_root
	if [ "$failures" -gt 0 ]; then
		echo "$failures problem(s) to fix before ./ok3d apply."
		return 1
	fi
	echo "Ready."
}

# The certificate authority, made once in the data root and kept: every new cluster loads the
# same one, so the devices that trust it keep trusting it. Its name constraint lets it vouch
# only for names under the domain.
make_certificate_authority() {
	certs="$DATA_ROOT/certs"
	install -d -m 0700 "$certs"
	if [ -f "$certs/ca.crt" ] && [ -f "$certs/ca.key" ]; then
		if openssl x509 -in "$certs/ca.crt" -noout -ext nameConstraints 2>/dev/null | grep -qF "DNS:.$DOMAIN"; then
			echo "The certificate authority in $certs is kept."
			return
		fi
		echo "The certificate authority in $certs is for another domain, not $DOMAIN. Move" >&2
		echo "$certs aside (your devices will need to trust the new one), then run ./ok3d apply." >&2
		exit 1
	fi
	echo "Making the certificate authority in $certs (for $DOMAIN and the names under it)."
	(
		umask 077
		openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
			-keyout "$certs/ca.key" -out "$certs/ca.crt" -days 3650 \
			-subj "/O=ok3d/CN=ok3d certificate authority for $DOMAIN" \
			-addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
			-addext "keyUsage=critical,keyCertSign,cRLSign" \
			-addext "nameConstraints=critical,permitted;DNS:$DOMAIN,permitted;DNS:.$DOMAIN" \
			2>/dev/null
	)
	chmod 0644 "$certs/ca.crt"
}

make_cluster() {
	if k3d cluster get "$CLUSTER_NAME" >/dev/null 2>&1; then
		echo "The cluster $CLUSTER_NAME is there already."
		return
	fi
	echo "Making the cluster $CLUSTER_NAME."
	# One server node and no agents. The data root goes into the node at /var/lib/ok3d, and
	# kagent's sandbox folder at /var/lib/ate (it can't live on the node's overlay filesystem).
	# The API listens on 127.0.0.1 only; the web pages are published on publishAddress. The
	# default kubeconfig gets the cluster's context, but your current context stays as it is.
	k3d cluster create "$CLUSTER_NAME" \
		--image "$K3S_IMAGE" \
		--servers 1 --agents 0 \
		--network "$NETWORK" \
		--api-port "127.0.0.1:$API_PORT" \
		--port "$PUBLISH_ADDRESS:$HTTPS_PORT:443@loadbalancer" \
		--volume "$DATA_ROOT:/var/lib/ok3d@server:0" \
		--volume "$DATA_ROOT/kagent-ate:/var/lib/ate@server:0" \
		--k3s-arg "--disable=traefik@server:0" \
		--kubeconfig-update-default --kubeconfig-switch-context=false \
		--wait --timeout 300s
}

# The namespaces Secrets must be in before Helm runs, made first, with the restricted Pod
# Security Standard's labels already on (so nothing is ever admitted without them).
# monitoring is the release's own namespace. gateway is the chart's (templates/namespaces.yaml),
# so it also gets Helm's ownership marks, which let the release take it over as its own.
make_namespaces() {
	kubectl --context "$context" apply --filename - >/dev/null <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
  labels:
    app.kubernetes.io/part-of: ok3d
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: gateway
  labels:
    app.kubernetes.io/part-of: ok3d
    app.kubernetes.io/managed-by: Helm
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
  annotations:
    meta.helm.sh/release-name: ok3d
    meta.helm.sh/release-namespace: monitoring
EOF
}

# ok3d's admin password: OK3D_ADMIN_PASSWORD from .env, or one made the first time and kept in
# the data root (admin-password, readable only by you). It's Grafana's admin login, and the
# login for the Prometheus and Alertmanager pages.
admin_password() {
	password=$(env_value_if_any OK3D_ADMIN_PASSWORD)
	if [ -n "$password" ]; then
		printf '%s' "$password"
		return
	fi
	if [ ! -s "$DATA_ROOT/admin-password" ]; then
		(umask 077 && openssl rand -base64 18 | tr -d '\n' >"$DATA_ROOT/admin-password")
		echo "Made ok3d's admin password: it's in $DATA_ROOT/admin-password" >&2
	fi
	cat "$DATA_ROOT/admin-password"
}

# The ok3d-admin Secret, in monitoring (for Grafana) and gateway (for the pages' basic auth),
# with the password on kubectl's standard input.
load_admin_secret() {
	password=$1
	for namespace in monitoring gateway; do
		printf 'admin-user=admin\nadmin-password=%s\n' "$password" |
			kubectl --context "$context" --namespace "$namespace" create secret generic ok3d-admin \
				--from-env-file=/dev/stdin --dry-run=client --output yaml |
			kubectl --context "$context" apply --filename - >/dev/null
	done
}

# 0.3 installed the ok3d release into ok3d-system. From 0.4 it lives in monitoring, the
# namespace its charts install into, so a cluster made by 0.3 has its old release removed
# first. (Its namespaces were empty, and the certificate is issued again from the same
# authority.) A cluster made from scratch skips this.
move_release_from_0_3() {
	helm status ok3d --kube-context "$context" --namespace ok3d-system >/dev/null 2>&1 || return 0
	echo "Moving the ok3d release from ok3d-system (0.3) to monitoring."
	helm uninstall ok3d --kube-context "$context" --namespace ok3d-system --wait >/dev/null
	kubectl --context "$context" delete namespace ok3d-system --wait=true >/dev/null
}

# With modules.unifi on: UNIFI_API_KEY from .env, in the ok3d-unifi Secret that only unpoller
# reads. The key goes to kubectl on its standard input, never on a command line, where other
# users on this machine could see it.
load_unifi_key() {
	[ "$MODULE_UNIFI" = true ] || return 0
	key=$(env_value UNIFI_API_KEY)
	[ -n "$key" ] || {
		echo "modules.unifi is on, but UNIFI_API_KEY in .env is empty." >&2
		exit 1
	}
	printf '%s' "$key" | kubectl --context "$context" --namespace monitoring create secret generic ok3d-unifi \
		--from-file=api-key=/dev/stdin --dry-run=client --output yaml |
		kubectl --context "$context" apply --filename - >/dev/null
}

# The ok3d-alerts Secret, which Alertmanager reads as files: the ntfy address (built here from
# the server and NTFY_TOPIC, with ntfy's own Alertmanager template and the cluster's name as a
# tag), its token, the mail password, and the dead man's switch's address, each only when its
# destination is on. Made even when nothing is on, since Alertmanager mounts it either way. The
# values go to kubectl on its standard input, never on a command line.
load_alert_secrets() {
	{
		[ "$ALERTS_NTFY" != true ] ||
			printf 'NTFY_URL=%s/%s?template=alertmanager&tags=%s\n' "$ALERTS_NTFY_SERVER" "$(env_value NTFY_TOPIC)" "$CLUSTER_NAME"
		[ "$ALERTS_NTFY" != true ] || [ "$ALERTS_NTFY_TOKEN" != true ] || printf 'NTFY_TOKEN=%s\n' "$(env_value NTFY_TOKEN)"
		[ "$ALERTS_EMAIL" != true ] || printf 'SMTP_PASSWORD=%s\n' "$(env_value SMTP_PASSWORD)"
		[ "$ALERTS_DEADMAN" != true ] || printf 'DEADMAN_URL=%s\n' "$(env_value DEADMAN_URL)"
		# Something to mount when nothing is on.
		printf 'NONE=\n'
	} | kubectl --context "$context" --namespace monitoring create secret generic ok3d-alerts \
		--from-env-file=/dev/stdin --dry-run=client --output yaml |
		kubectl --context "$context" apply --filename - >/dev/null
}

deploy() {
	echo "Deploying the platform: cert-manager and the Prometheus operator's definitions."
	helm upgrade --install ok3d-platform chart/ok3d-platform \
		--kube-context "$context" --namespace cert-manager --create-namespace \
		--wait --timeout 10m
	echo "Loading the certificate authority into the cluster."
	kubectl --context "$context" --namespace cert-manager create secret tls ok3d-ca \
		--cert "$DATA_ROOT/certs/ca.crt" --key "$DATA_ROOT/certs/ca.key" \
		--dry-run=client --output yaml | kubectl --context "$context" apply --filename -
	move_release_from_0_3
	make_namespaces
	load_unifi_key
	load_alert_secrets
	password=$(admin_password)
	load_admin_secret "$password"
	echo "Deploying ok3d."
	# Prometheus runs as you (the data root's owner), and keeps the history your settings ask
	# for. Those go to the kube-prometheus-stack chart directly, since a chart's settings can't
	# be read by the charts inside it.
	uid=$(id -u)
	gid=$(id -g)
	p=kube-prometheus-stack.prometheus.prometheusSpec
	a=kube-prometheus-stack.alertmanager.alertmanagerSpec
	g=kube-prometheus-stack.grafana
	# The gateway restarts when the password changes: it gets a checksum, never the password.
	checksum=$(printf '%s' "$password" | openssl dgst -sha256 -r | cut -d' ' -f1)
	# shellcheck disable=SC2046 # values_args prints one argument per line, on purpose
	helm upgrade --install ok3d chart/ok3d $(values_args) \
		--set "host.uid=$uid,host.gid=$gid" \
		--set "$p.securityContext.runAsUser=$uid,$p.securityContext.runAsGroup=$gid,$p.securityContext.fsGroup=$gid" \
		--set "$a.securityContext.runAsUser=$uid,$a.securityContext.runAsGroup=$gid,$a.securityContext.fsGroup=$gid" \
		--set "$g.securityContext.runAsUser=$uid,$g.securityContext.runAsGroup=$gid,$g.securityContext.fsGroup=$gid" \
		--set "$g.grafana\.ini.server.root_url=https://grafana.$DOMAIN:$HTTPS_PORT/" \
		--set-file "tls.caCertificate=$DATA_ROOT/certs/ca.crt" \
		--set "gateway.adminChecksum=$checksum" \
		--set "$p.retention=$METRICS_RETENTION,$p.retentionSize=$METRICS_RETENTION_SIZE" \
		--kube-context "$context" --namespace monitoring \
		--wait --timeout 10m
	kubectl --context "$context" --namespace gateway wait certificate/ok3d-pages \
		--for=condition=Ready --timeout=120s
}

# Puts the cluster's node on the demo network, if both are there, so Prometheus can reach the
# simulated devices. A new cluster needs this again, so apply and demo up both call it.
connect_demo() {
	docker network inspect "$demo_network" >/dev/null 2>&1 || return 0
	node="k3d-$CLUSTER_NAME-server-0"
	docker container inspect "$node" >/dev/null 2>&1 || return 0
	if ! docker network inspect "$demo_network" --format '{{range .Containers}}{{.Name}} {{end}}' |
		grep -qw "$node"; then
		docker network connect "$demo_network" "$node"
		echo "The cluster's node is on the demo network."
	fi
}

cmd_apply() {
	cmd_check
	if [ "$(id -u)" = 0 ]; then
		echo "Run ok3d as yourself, not as root: what it keeps in the data root should be yours." >&2
		exit 1
	fi
	# The data root's folders, owned by you, before anything is deployed that uses them.
	install -d -m 0755 "$DATA_ROOT/kagent-ate"
	install -d -m 0750 "$DATA_ROOT/prometheus"
	install -d -m 0750 "$DATA_ROOT/alertmanager"
	install -d -m 0750 "$DATA_ROOT/grafana"
	make_certificate_authority
	make_cluster
	connect_demo
	deploy
	port=""
	[ "$HTTPS_PORT" = 443 ] || port=":$HTTPS_PORT"
	echo
	echo "Done. The cluster $CLUSTER_NAME is up (kubectl context $context). Its pages:"
	echo "  https://grafana.$DOMAIN$port/        Grafana: sign in as admin"
	echo "  https://prometheus.$DOMAIN$port/     Prometheus: the same login"
	echo "  https://alertmanager.$DOMAIN$port/   Alertmanager: the same login"
	echo "  https://ca.$DOMAIN$port/             the certificate authority, to trust on your devices"
	if [ -z "$(env_value_if_any OK3D_ADMIN_PASSWORD)" ]; then
		echo "The admin password is in $DATA_ROOT/admin-password."
	fi
	echo "Point *.$DOMAIN at this computer in your router or local DNS server (docs/certificate.md)."
}

cmd_delete() {
	yes=${1:-}
	load_settings
	if [ "$yes" != --yes ]; then
		if [ ! -t 0 ]; then
			echo "Deleting needs a yes: run ./ok3d delete --yes, or run it in a terminal to be asked." >&2
			exit 1
		fi
		printf 'Delete the cluster %s? The data root %s stays. Type the cluster name to go ahead: ' \
			"$CLUSTER_NAME" "$DATA_ROOT"
		read -r answer
		if [ "$answer" != "$CLUSTER_NAME" ]; then
			echo "Not deleted."
			exit 1
		fi
	fi
	k3d cluster delete "$CLUSTER_NAME"
	echo "Deleted. Everything in $DATA_ROOT is still there: ./ok3d apply brings the cluster back."
}

# Reads demo/network.tsv: one "name address role unifi_type model http" line per device,
# without the comments.
demo_devices() {
	grep -v -e '^#' -e '^[[:space:]]*$' demo/network.tsv
}

# demo_known NAME: whether NAME is one of the demo's devices.
demo_known() {
	demo_devices | awk '{print $1}' | grep -qx "$1"
}

demo_up() {
	if ! docker network inspect "$demo_network" >/dev/null 2>&1; then
		docker network create --subnet "$demo_subnet" --gateway "$demo_gateway" --ip-range "$demo_dynamic" \
			--label ok3d.demo=true "$demo_network" >/dev/null
		echo "Made the demo network, $demo_subnet."
	fi
	# The image, fetched quietly the first time, instead of Docker's layer-by-layer progress.
	if ! docker image inspect "$demo_image" >/dev/null 2>&1; then
		echo "Fetching the demo's image (once)."
		docker pull --quiet "$demo_image" >/dev/null
	fi
	# The failed list starts empty: every device comes up working.
	install -d -m 0755 "$state"
	: >"$state/failed"
	demo_devices | while read -r name address _role _unifi _model http; do
		container="ok3d-demo-$name"
		if docker container inspect "$container" >/dev/null 2>&1; then
			docker start "$container" >/dev/null
			continue
		fi
		# What the device runs: the fake UniFi controller, a web page, or nothing but its
		# network stack, which answers ping.
		case "$name:$http" in
		unifi-controller:*) set -- python /app/ok3d/demo_exporter.py --network /app/network.tsv --state /state --port 9130 ;;
		*:http) set -- python /app/ok3d/demo_device.py --name "$name" --port 80 ;;
		*) set -- sleep 2147483647 ;;
		esac
		# Locked down like everything ok3d runs: read-only, no capabilities, not root, no way
		# to gain privileges, and small limits. Serving port 80 as a normal user takes only a
		# setting inside the container's own network namespace. --init stops a device at once
		# when it's failed, instead of after Docker's 10-second wait.
		docker run --detach --init --name "$container" --hostname "$name" \
			--network "$demo_network" --ip "$address" --label ok3d.demo=true \
			--read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 \
			--sysctl net.ipv4.ip_unprivileged_port_start=0 --memory 64m --pids-limit 64 \
			--volume "$root/src/ok3d:/app/ok3d:ro" --volume "$root/demo/network.tsv:/app/network.tsv:ro" \
			--volume "$state:/state:ro" \
			"$demo_image" "$@" >/dev/null
		echo "Started $name at $address."
	done
	connect_demo
}

demo_down() {
	containers=$(docker ps --all --quiet --filter label=ok3d.demo=true)
	# One argument per container ID, so the list is split on purpose.
	# shellcheck disable=SC2086
	[ -z "$containers" ] || docker rm --force $containers >/dev/null
	if docker network inspect "$demo_network" >/dev/null 2>&1; then
		node="k3d-$CLUSTER_NAME-server-0"
		docker network disconnect "$demo_network" "$node" >/dev/null 2>&1 || true
		docker network rm "$demo_network" >/dev/null
	fi
	rm -rf "$state"
	echo "The simulated network is gone."
}

cmd_demo() {
	sub=${1:-}
	device=${2:-}
	load_settings
	state="$DATA_ROOT/demo"
	case "$sub" in
	up) demo_up ;;
	down) demo_down ;;
	status)
		docker ps --all --filter label=ok3d.demo=true --format '{{.Names}}\t{{.Status}}' |
			sed 's/^ok3d-demo-//' | sort
		;;
	fail | fix)
		if [ -z "$device" ] || ! demo_known "$device"; then
			echo "Name one of the demo's devices: $(demo_devices | awk '{print $1}' | tr '\n' ' ')" >&2
			exit 2
		fi
		install -d -m 0755 "$state"
		touch "$state/failed"
		grep -vx "$device" "$state/failed" >"$state/failed.new" || true
		if [ "$sub" = fail ]; then
			echo "$device" >>"$state/failed.new"
			docker stop "ok3d-demo-$device" >/dev/null
			echo "$device is down. ./ok3d demo fix $device brings it back."
		else
			docker start "ok3d-demo-$device" >/dev/null
			echo "$device is back."
		fi
		mv "$state/failed.new" "$state/failed"
		;;
	*)
		echo "./ok3d demo up | down | status | fail <device> | fix <device>" >&2
		exit 2
		;;
	esac
}

# A test alert, through the real path: Alertmanager's own amtool adds it, and Alertmanager
# sends it wherever alerts go. It clears itself after 5 minutes.
cmd_test_alert() {
	load_settings
	pod=alertmanager-ok3d-kube-prometheus-stack-alertmanager-0
	ends=$(date -u -d '+5 minutes' '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -v+5M '+%Y-%m-%dT%H:%M:%SZ')
	kubectl --context "$context" --namespace monitoring exec "$pod" --container alertmanager -- \
		amtool alert add OK3DTestAlert severity=warning device=ok3d \
		--annotation="summary=\"A test alert from ./ok3d test-alert. If you can read this, alerts reach you.\"" \
		--end="$ends" --alertmanager.url=http://localhost:9093
	echo "Sent. It should arrive within a minute, wherever your alerts go (docs/alerts.md)."
}

# cmd_validate KIND FILE: the same checks check runs on settings.yaml or devices.yaml, on
# another file, so a new one can be checked before it replaces yours.
cmd_validate() {
	kind=${1:-}
	file=${2:-}
	option=${3:-}
	if [ -z "$file" ] || [ ! -f "$file" ] || { [ -n "$option" ] && [ "$kind $option" != "settings --from-dashboard" ]; }; then
		echo "Usage: ./ok3d validate settings FILE [--from-dashboard], or ./ok3d validate devices FILE" >&2
		exit 2
	fi
	case "$kind" in
	settings)
		current=$settings
		settings=$file
		load_settings
		if [ -f "$devices" ] && ! helm template ok3d chart/ok3d --values "$file" --values "$devices" >/dev/null; then
			fail "the settings in $file, with your devices in $devices (above)"
			exit 1
		fi
		# From the Dashboard, the settings only you may change must stay as they are. (Before
		# there are any settings, at first setup, there's nothing to keep.)
		if [ "$option" = --from-dashboard ] && [ -f "$current" ]; then
			was=$(mktemp)
			protected_settings "$current" | sort >"$was"
			changed=$(protected_settings "$file" | sort | comm -3 "$was" - | sed 's/^[[:space:]]*//; s/=.*//' | sort -u)
			rm -f "$was"
			if [ -n "$changed" ]; then
				fail "the Dashboard can't change these settings; edit $current on the server instead: $(printf '%s' "$changed" | tr '\n' ' ')"
				exit 1
			fi
		fi
		pass "the settings in $file"
		;;
	devices)
		load_settings
		if check_sections devices "$file" && helm template ok3d chart/ok3d --values "$settings" --values "$file" >/dev/null; then
			pass "the devices in $file"
		else
			fail "the devices in $file (above)"
			exit 1
		fi
		;;
	*)
		echo "Usage: ./ok3d validate settings|devices FILE" >&2
		exit 2
		;;
	esac
}

cmd_version() {
	sed -n 's/^__version__ = "\(.*\)"$/ok3d \1/p' src/ok3d/__init__.py
}

case "${1:-}" in
check) cmd_check ;;
apply) cmd_apply ;;
delete) cmd_delete "${2:-}" ;;
demo) cmd_demo "${2:-}" "${3:-}" ;;
test-alert) cmd_test_alert ;;
validate) cmd_validate "${2:-}" "${3:-}" "${4:-}" ;;
version | --version) cmd_version ;;
help | --help | -h) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
