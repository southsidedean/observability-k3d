#!/bin/sh
# Runs on every commit's message, once turned on with: git config core.hooksPath .githooks
#
# Refuses a message that holds a private name from .git/hooks/private-names, the same check
# the pre-commit hook makes on the files (scripts/private-names.sh). It says which line, not
# the text. No list, no check: a fresh clone or CI has none. Anything else that goes wrong
# stops the commit. A real emergency can skip it with git commit --no-verify.
set -eu

names=$(dirname "$0")/../scripts/private-names.sh
list="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/private-names"
if [ -s "$list" ] && [ ! -f "$names" ]; then
	echo "There's a private-names list, but not $names to check it with." >&2
	exit 1
fi
status=0
sh "$names" patterns >/dev/null || status=$?
[ "$status" -ne 3 ] || exit 0
if [ "$status" -ne 0 ]; then
	echo "The private-names check couldn't run (above), so nothing was committed." >&2
	exit 1
fi
# git's own comment lines (# On branch ...) aren't part of the message, so they're left out.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
grep -v '^#' "$1" >"$work/message" || true
if ! sh "$names" check "$work/message" 2>"$work/said"; then
	echo "The commit message names something from your private-names list. Use a stand-in" >&2
	echo "(192.168.1.20, my-server.lan, noc.home.arpa) instead, on $(sed -n 's/^.*: a private name on //p' "$work/said")." >&2
	exit 1
fi
