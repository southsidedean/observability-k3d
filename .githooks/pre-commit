#!/bin/sh
# Runs before every commit, once turned on with: git config core.hooksPath .githooks
#
# Refuses a commit that:
#   1. is on main (changes reach main only through pull requests),
#   2. adds anyone's own setup or a key (settings.yaml, devices.yaml, .env, local/, ...),
#   3. adds a line that looks like a secret,
#   4. adds a private name: your own host names, domains, and addresses, listed one pattern
#      per line in .git/hooks/private-names, a file that stays on your machine
#      (scripts/private-names.sh does the matching),
#   5. adds or changes an image without IMAGES_CHECKED=1, which says every image was looked
#      at and its metadata stripped.
# A real emergency can skip it with git commit --no-verify.
set -eu

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = main ]; then
	echo "This is main. Make a branch (git switch -c <name>), commit there, and open a pull request." >&2
	exit 1
fi

# The files being added or changed, one per line.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# 2. Your own setup, at the repository's root where it lives (a chart file may share a name),
# and keys anywhere. The examples (*.example.yaml, .env.example) are fine.
own=$(printf '%s\n' "$staged" |
	grep -E '^(settings|devices)\.yaml$|^users\.yml$|^\.env$|^\.env\.[^/]*$|^local/|\.(pem|key|p12)$' |
	grep -v -E '^\.env\.example$' || true)
if [ -n "$own" ]; then
	echo "Not committing these: they're your own setup or keys, which stay on your machine." >&2
	printf '%s\n' "$own" | sed 's/^/  /' >&2
	exit 1
fi

# The lines being added, without the "+++ file" headers.
added=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+ ' || true)

# 3. Secrets: a private key, or a setting named like a password, key, or token given a value.
# The example files leave every one of them empty.
secrets=$(printf '%s\n' "$added" |
	grep -E 'BEGIN [A-Z ]*PRIVATE KEY|^\+[A-Z_]*(PASSWORD|PASS|API_KEY|TOKEN|SECRET)=[^[:space:]]' || true)
if [ -n "$secrets" ]; then
	echo "These lines look like secrets, which belong in .env and never in the repository:" >&2
	printf '%s\n' "$secrets" | sed 's/=.*/=.../; s/^/  /' >&2
	exit 1
fi

# 4. Private names, from the list, in each file as it's staged (scripts/private-names.sh,
# which also matches a name written with other separators). It says which file and line, not
# the text, so the name isn't shown wherever this output goes. No list, no check: a fresh
# clone or CI has none, and the tests' own checks still run.
names=$(dirname "$0")/../scripts/private-names.sh
list="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/private-names"
if [ -s "$list" ] && [ ! -f "$names" ]; then
	echo "There's a private-names list, but not $names to check it with." >&2
	exit 1
fi
if [ -f "$names" ] && sh "$names" patterns >/dev/null 2>&1; then
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	found=""
	while IFS= read -r file; do
		[ -n "$file" ] || continue
		git show ":$file" >"$work/staged" 2>/dev/null || continue
		if ! sh "$names" check "$work/staged" 2>"$work/said"; then
			found="$found  $file: $(sed -n 's/^.*: a private name on //p' "$work/said")
"
		fi
	done <<EOF
$staged
EOF
	if [ -n "$found" ]; then
		echo "These name something from your private-names list. Use a stand-in" >&2
		echo "(192.168.1.20, my-server.lan, noc.home.arpa) instead:" >&2
		printf '%s' "$found" >&2
		exit 1
	fi
fi

# 5. Images.
images=$(printf '%s\n' "$staged" | grep -i -E '\.(png|jpe?g|gif|webp|svg)$' || true)
if [ -n "$images" ] && [ "${IMAGES_CHECKED:-}" != 1 ]; then
	echo "This commit adds or changes images. Look at each one and strip its metadata, then" >&2
	echo "commit again with IMAGES_CHECKED=1:" >&2
	printf '%s\n' "$images" | sed 's/^/  /' >&2
	exit 1
fi

exit 0
