#!/bin/sh
# Runs before git makes a merge commit, which skips pre-commit: the same checks, so a merge
# can't bring in what pre-commit would refuse (a private name, a secret, your own files).
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = main ]; then
	echo "main takes changes only through pull requests, so it only ever fast-forwards here:" >&2
	echo "update it with git pull --ff-only, and make changes on a branch." >&2
	exit 1
fi
exec "$(dirname "$0")/pre-commit"
