# Your own setup. None of it is ever committed; the repository carries a commented example of
# each (settings.example.yaml, devices.example.yaml, .env.example). The pre-commit hook
# refuses these too, in case one is ever added with --force.
settings.yaml
devices.yaml
users.yml
.env
.env.*
!.env.example
local/

# Keys and certificates: the certificate authority and everything it issues stay in the
# data root, never in the repository.
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
build/
dist/

# Backup and temporary files
*.bak
*.tmp
*~
*.swp
*.swo

# macOS, editors, and tools
.DS_Store
.idea/
.vscode/
.claude/
claude-session.txt

# Helm chart dependencies, fetched at the versions in each Chart.lock.
chart/*/charts/
