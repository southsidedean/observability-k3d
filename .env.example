# ok3d's secrets, and nothing else. Copy this file to .env (which is never committed), fill in
# what you use, and make it readable only by you: chmod 600 .env
# Settings that aren't secret go in settings.yaml.
#
# Each secret goes only to the one part of ok3d that uses it. Leave a line empty if you don't
# use that part. This release reads none of them yet; each says which release does.

# --- UniFi (0.4) ---
# An API key from your UniFi controller, made for a view-only admin, so ok3d can read the
# controller and change nothing: Settings, Control Plane, Integrations, Create API Key.
UNIFI_API_KEY=

# --- Alerts (0.4) ---
# Your ntfy topic's full address, such as https://ntfy.sh/ok3d-7f3k9q2m8x. Pick a long, random
# topic name: anyone who knows it can read your alerts.
NTFY_URL=
# The password of the mailbox alerts are sent from, if you use email.
SMTP_PASSWORD=
# The address of your dead man's switch, such as a healthchecks.io check, which tells you when
# ok3d itself stops sending.
DEADMAN_URL=

# --- Agents (0.9) ---
# The API key for the AI model. The gateway holds it; no agent ever sees it.
ANTHROPIC_API_KEY=
